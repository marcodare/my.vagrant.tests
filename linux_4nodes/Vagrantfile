# frozen_string_literal: true
# Percorso assistito: crea le quattro VM, configura hostname, /etc/hosts e la
# NIC del lab, installa NTP e pochi strumenti di rete. Nessun servizio in più:
# gli esercizi restano in STEPS.md.

require 'json'
spec = JSON.parse(File.read(File.join(__dir__, 'lab.json')))

subnet = spec.fetch('subnet')
# mac_id diverso dalla subnet: il lab k3s usa già 66 come byte MAC, e 72
# sta fuori dal pool host-only così nessuna subnet futura lo erediterà.
mac_id = spec.fetch('mac_id', subnet)

# /etc/hosts generato dai nodi realmente dichiarati, così il file dentro il
# guest non elenca mai macchine che questo laboratorio non crea.
hosts = spec.fetch('nodes').map do |node|
  "192.168.#{subnet}.#{node.fetch('host')} #{node.fetch('name')}"
end.join(';')

Vagrant.configure('2') do |config|
  # Le box includono già le Guest Additions necessarie. Il plugin opzionale
  # vagrant-vbguest è archiviato e, se presente sull'host, tenta di allinearle
  # prima dei provisioner: con una box datata può fallire su indici APT non più
  # coerenti. Il lab non usa shared folder, quindi l'aggiornamento non serve.
  config.vbguest.auto_update = false if Vagrant.has_plugin?('vagrant-vbguest')

  # Box e versione sono per nodo: ogni macchina ha la propria distribuzione.
  config.vm.box_architecture = 'amd64'
  config.vm.synced_folder '.', '/vagrant', disabled: true
  config.vm.boot_timeout = 900

  spec.fetch('nodes').each_with_index do |node, index|
    address = "192.168.#{subnet}.#{node.fetch('host')}"
    lab_mac = format('080027%02X%02X02', mac_id, index + 1)

    config.vm.define node.fetch('name') do |vm|
      vm.vm.box = node.fetch('box')
      vm.vm.box_version = node.fetch('box_version')
      vm.vm.hostname = node.fetch('name')
      # NIC 1 NAT per SSH e pacchetti; NIC 2 host-only, la rete del laboratorio.
      vm.vm.network 'private_network', ip: address, auto_config: false

      vm.vm.provider 'virtualbox' do |vb|
        vb.name = "#{spec.fetch('id')}-#{node.fetch('name')}"
        vb.memory = node.fetch('memory')
        vb.cpus = node.fetch('cpus')
        vb.gui = false
        vb.customize ['modifyvm', :id, '--macaddress2', lab_mac]
        vb.customize ['modifyvm', :id, '--nested-hw-virt', 'off']
        vb.customize ['modifyvm', :id, '--nicpromisc2', 'allow-all']
      end
      vm.vm.disk :disk, size: '80GB', primary: true
      # Il MAC arriva con i due punti: è il formato atteso da netplan e nmcli.
      vm.vm.provision 'shell', path: 'scripts/provision/base.sh',
        args: [node.fetch('name'), address, lab_mac.scan(/../).join(':').downcase, hosts]
      vm.vm.provision 'shell', path: "scripts/provision/#{node.fetch('role')}.sh"
    end
  end
end
